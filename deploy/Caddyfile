{$PLANAR_DOMAIN::80} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# sha256 встроенного скрипта темы из apps/web/index.html; поменяли скрипт — обновить хэш (тест ops-contract)
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-1qyOtcebjd/bv3V5Fdv9/5J89gBg5K0s/b5zYk1OBHc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	@backend path /api/* /sync/* /ws /collab /mcp* /files /files/*
	handle @backend {
		reverse_proxy api:3000
	}

	handle /f/* {
		root * /srv
		rewrite * /form.html
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
