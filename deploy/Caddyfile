{$PLANAR_DOMAIN::80} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# sha256 of the inline theme script from apps/web/index.html; if the script changes, update the hash (ops-contract test)
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-1qyOtcebjd/bv3V5Fdv9/5J89gBg5K0s/b5zYk1OBHc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' {$CLOUD_URL}; worker-src 'self'; manifest-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# container-only endpoints (run secret, internal network): not reachable from outside
	@agentOnly {
		method POST
		path_regexp ^/api/ai/(llm/.*|runs/[^/]+(/heartbeat|/events)?)$
	}
	handle @agentOnly {
		respond 404
	}

	@backend path /api/* /sync/* /ws /collab /mcp* /files /files/*
	handle @backend {
		reverse_proxy api:3000
	}

	# static: hashed /assets/* never change; everything else (html, sw.js, push-sw.js, manifest) is revalidated —
	# without it a CDN in front (Cloudflare) caches sw.js for hours and the PWA does not see a new release
	@hashed path /assets/*
	@static not path /api/* /sync/* /ws /collab /mcp* /files /files/* /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @static Cache-Control "no-cache"

	handle /f/* {
		root * /srv
		rewrite * /form.html
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
