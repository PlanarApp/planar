{
  "permissions": {
    "allow": [
      "Bash(.dpcli/dpcli *)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".dpcli/dpcli update --auto"
          }
        ]
      }
    ]
  }
}
