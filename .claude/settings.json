{
  "permissions": {
    "allow": [
      "Bash(.dpcli/dpcli *)",
      "Bash(gh api -X PUT repos/zolotarev/dpcli/actions/permissions/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".dpcli/dpcli update --auto"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.dpcli/hooks/bash_guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
