+/**
+ * P4: справочники пространства (статусы, метки, участники) — один liveQuery на (вид, spaceId) на всех подписчиков.
+ * Раньше каждый пикер в каждой строке создавал свой: 27 строк × 4 пикера ≈ 100 подписок на каждый вход в проект.
+ */
+const shared = new Map<string, { r: Ref<unknown>; sub: Subscription; n: number }>();
+function useShared<T>(kind: string, arg: () => string, fn: (a: string) => Promise<T>) {
+  const out = shallowRef<T>();
+  let key = '';
+  const release = () => {
+    const x = shared.get(key);
+    if (x && --x.n === 0) (x.sub.unsubscribe(), shared.delete(key));
+  };
+  watch(
+    arg,
+    (a) => {
+      release();
+      key = kind + a;
+      let x = shared.get(key);
+      if (!x) {
+        const r = shallowRef<T>();
+        x = { r, sub: liveQuery(() => fn(a)).subscribe({ next: (v) => (r.value = v), error: () => {} }), n: 0 };
+        shared.set(key, x);
+      }
+      x.n++;
+      out.value = x.r.value as T;
+      watch(x.r, (v) => (out.value = v as T), { flush: 'sync' });
+    },
+    { immediate: true, flush: 'sync' },
+  );
+  if (getCurrentScope()) onScopeDispose(release);
+  return out as Readonly<Ref<T | undefined>>;
+}
