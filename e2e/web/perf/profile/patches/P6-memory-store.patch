+/** P6: построчные изменения реплики (после коммита) — для проекций в памяти; `reset` — реплика заменена целиком. */
+export type RowChange = { entity: string; id: string; row: Record<string, unknown> | null } | { reset: true };
+const subs = new Set<(c: RowChange[]) => void>();
+export const onRowChanges = (cb: (c: RowChange[]) => void): (() => void) => (subs.add(cb), () => void subs.delete(cb));
+export const emitChanges = (c: RowChange[]): void => {
+  if (c.length) for (const cb of [...subs]) cb(c);
+};
