+    (pid) => {
+      off?.();
+      r.value = undefined;
+      const g = ++gen;
+      let state: ProjectState | undefined;
+      let queue: RowChange[] | undefined = []; // события, пришедшие во время чтения
+      const publish = () => (r.value = [...state!.tasks.values()]);
+      const load = async () => {
+        queue = [];
+        state = undefined;
+        const st = await loadState(pid);
+        if (g !== gen) return;
+        state = st;
