+/**
+ * P6: задачи проекта в памяти. Один раз читаем из IndexedDB, дальше патчим по событиям записи реплики
+ * (sync: DexieTx / applyServer), без повторного чтения таблиц. `reset` (bootstrap) — перечитать.
+ * shortcut: изменения из других вкладок не видны (нужна пересылка событий через BroadcastChannel).
+ */
+export function useProjectTasks(projectId: MaybeRefOrGetter<string>): Readonly<Ref<TaskView[] | undefined>> {
+  const r = shallowRef<TaskView[]>();
+  let off: (() => void) | undefined;
+  let gen = 0;
+  watch(
