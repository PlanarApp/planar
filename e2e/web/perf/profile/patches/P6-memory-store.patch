+  if (getCurrentScope()) onScopeDispose(() => (off?.(), gen++));
+  return readonly(r) as Readonly<Ref<TaskView[] | undefined>>;
+}
+
+interface ProjectState {
+  pid: string;
+  key: string;
+  tasks: Map<string, TaskView>;
+  a: Map<string, { t: string; v: string }>; // строки taskAssignees проекта: id → задача, пользователь
+  l: Map<string, { t: string; v: string }>;
+}
+
+async function loadState(pid: string): Promise<ProjectState> {
+  const [project, tasks, as, ls] = await Promise.all([
+    db.table<Row<'projects'>>('projects').get(pid),
+    db.table<Row<'tasks'>>('tasks').where('projectId').equals(pid).toArray(),
+    db.table<Row<'taskAssignees'>>('taskAssignees').toArray(),
+    db.table<Row<'taskLabels'>>('taskLabels').toArray(),
+  ]);
+  const ids = new Set(tasks.map((t) => t.id));
+  const st: ProjectState = { pid, key: project?.key ?? '?', tasks: new Map(), a: new Map(), l: new Map() };
+  const am = new Map<string, string[]>();
+  const lm = new Map<string, string[]>();
+  for (const x of as)
+    if (ids.has(x.taskId)) {
+      st.a.set(x.id, { t: x.taskId, v: x.userId });
+      (am.get(x.taskId) ?? am.set(x.taskId, []).get(x.taskId)!).push(x.userId);
+    }
+  for (const x of ls)
+    if (ids.has(x.taskId)) {
+      st.l.set(x.id, { t: x.taskId, v: x.labelId });
+      (lm.get(x.taskId) ?? lm.set(x.taskId, []).get(x.taskId)!).push(x.labelId);
+    }
+  for (const t of tasks)
+    st.tasks.set(t.id, { ...t, key: `${st.key}-${t.number ?? '…'}`, assigneeIds: am.get(t.id) ?? [], labelIds: lm.get(t.id) ?? [] });
+  return st;
+}
+
+/** false — событие требует перечитать проект (reset, смена самого проекта) */
+function applyChanges(st: ProjectState, cs: RowChange[]): boolean {
+  const link = (m: Map<string, { t: string; v: string }>, c: { id: string; row: Record<string, any> | null }, f: 'assigneeIds' | 'labelIds', val: string) => {
+    const old = m.get(c.id);
+    if (old) {
+      m.delete(c.id);
+      const t = st.tasks.get(old.t);
+      if (t) st.tasks.set(t.id, { ...t, [f]: t[f].filter((x) => x !== old.v) });
+    }
+    const t = c.row && st.tasks.get(c.row.taskId);
+    if (c.row && t) {
+      m.set(c.id, { t: t.id, v: c.row[val] });
+      st.tasks.set(t.id, { ...t, [f]: [...t[f], c.row[val]] });
+    }
+  };
+  for (const c of cs) {
+    if ('reset' in c) return false;
+    if (c.entity === 'projects' && c.id === st.pid) return false;
+    if (c.entity === 'tasks') {
+      const old = st.tasks.get(c.id);
+      if (c.row && c.row.projectId === st.pid) {
+        const row = c.row as Row<'tasks'>;
+        st.tasks.set(c.id, { ...row, key: `${st.key}-${row.number ?? '…'}`, assigneeIds: old?.assigneeIds ?? [], labelIds: old?.labelIds ?? [] });
+      } else if (old) st.tasks.delete(c.id);
+    } else if (c.entity === 'taskAssignees') link(st.a, c, 'assigneeIds', 'userId');
+    else if (c.entity === 'taskLabels') link(st.l, c, 'labelIds', 'labelId');
+  }
+  return true;
+}
 
