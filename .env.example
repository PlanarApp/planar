# api (dev sets them itself in compose.dev.yml; here — for running outside compose and for prod)
DATABASE_URL=postgres://postgres:postgres@localhost:55433/planar
PORT=3000
# origin for the Origin and cookie check, e.g. http://localhost:5173
PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false
DATA_DIR=./data
MAX_UPLOAD_MB=50
# if set, POST /api/setup (first owner) needs the header X-Setup-Token with this value; empty — open until the first user
SETUP_TOKEN=
# max connections in the Postgres pool (integer >= 1); empty — 10
DB_POOL_MAX=
# true — public demo: banner, "Try the demo" login, no outgoing email/push/webhooks/GitLab polling, MAX_UPLOAD_MB defaults to 2
DEMO_MODE=false
# hours between demo resets (only the banner text; the reset itself is a cron job)
DEMO_RESET_HOURS=24
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
LOG_LEVEL=info

# compose
DEV_PG_PORT=55433
# parallel dev stacks: COMPOSE_PROJECT_NAME, API_PORT (3000), WEB_PORT (5173); e2e takes E2E_BASE_URL
# prod compose
POSTGRES_PASSWORD=postgres
SITE_ADDRESS=:80
# registry and tag of the api and caddy images that compose.yml pulls (compose.build.yml builds from source instead)
# PLANAR_REGISTRY=registry.gitlab.com/planarhq/planar
# PLANAR_VERSION=latest
