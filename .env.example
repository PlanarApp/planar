# Planar configuration. Copy to .env and edit.
# Production (compose.yml / start.sh) reads every variable below; an empty value means the default.
# Development: compose.dev.yml sets the api variables itself; the api values here are for running
# the api outside compose (pnpm dev) against the dev Postgres.

# compose files; start.sh writes compose.yml:compose.prod.yml so the ops/ scripts use the same stack
# COMPOSE_FILE=compose.yml:compose.prod.yml

# --- images (compose.yml) ---
# registry of the api and caddy images: registry.gitlab.com/planarhq/planar (default) | ghcr.io/planarapp
# (on ghcr the images are named planar-api / planar-caddy, so the GitLab registry is the simple choice)
PLANAR_REGISTRY=registry.gitlab.com/planarhq/planar
# image tag: latest (last release, default) | X.Y (latest patch of a minor, e.g. 0.10) | X.Y.Z (pinned, e.g. 0.10.0) | edge (main, unstable)
PLANAR_VERSION=latest

# --- domain and network (compose.yml) ---
# domain, e.g. planar.example.com — Caddy gets a TLS certificate from Let's Encrypt and redirects HTTP to HTTPS
# localhost or an IP — self-signed certificate from Caddy's internal CA (start.sh writes localhost when empty)
# empty with plain docker compose — HTTP only on :80 (local check only)
PLANAR_DOMAIN=
# host ports Caddy listens on: 80 / 443 (default); change if they are taken
HTTP_PORT=80
HTTPS_PORT=443
# subnet of the internal docker network; the api trusts X-Forwarded-For only from it. Change if it overlaps your networks
PLANAR_SUBNET=172.30.0.0/24

# --- database ---
# password of the postgres user; required in production, empty — start.sh generates one (dev uses its own: postgres)
# do not change after the first start: it is stored in the volume
POSTGRES_PASSWORD=
# api outside compose only (compose builds it from POSTGRES_PASSWORD)
DATABASE_URL=postgres://postgres:postgres@localhost:55433/planar
# max connections in the api's Postgres pool: integer >= 1; empty — 10
DB_POOL_MAX=

# --- api: http ---
# api outside compose only: listen port (3000) and file storage directory (compose: the ./data volume)
PORT=3000
DATA_DIR=./data
# public origin: used for the Origin check and in links (email, push). Production empty — https://$PLANAR_DOMAIN
# examples: https://planar.example.com | http://localhost:8080 | http://localhost:5173 (dev web)
PUBLIC_URL=http://localhost:5173
# extra allowed Origins, comma-separated, e.g. https://planar.example.org,http://10.0.0.5; links still use PUBLIC_URL
EXTRA_ORIGINS=
# true (production default) — cookies only over HTTPS | false — when serving over plain HTTP (local, dev)
COOKIE_SECURE=false

# --- api: secrets and access ---
# 32 random bytes in base64, generate: openssl rand -base64 32 (start.sh generates it if missing)
# encrypts stored tokens (GitLab); empty — features that need it answer 503. Do not change after the first start
PLANAR_SECRET_KEY=
# set — creating the first owner (POST /api/setup) requires the header X-Setup-Token with this value
# empty — setup is open until the first user exists
SETUP_TOKEN=
# token for /api/metrics (Prometheus, header Authorization: Bearer <token>); empty — the endpoint answers 404
METRICS_TOKEN=
# Planar Cloud hosting (written by the cloud CLI, docs/contracts/cloud-link.md); both or neither
# set — Settings › Cloud (domain, trial, payment), trial badge, sign-in closed after the trial ends
# empty — a self-hosted instance, none of that
CLOUD_URL=
CLOUD_TOKEN=

# --- api: limits and logs ---
# upload size limit in MB; empty — 50 (2 in demo mode)
MAX_UPLOAD_MB=50
# trace | debug | info (default) | warn | error | fatal | silent
LOG_LEVEL=info

# --- api: Web Push (all three or none; generate keys: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contact of the server owner: mailto:admin@example.com | https://example.com
VAPID_SUBJECT=

# --- demo ---
# true — public demo: banner, "Try the demo" login, no outgoing email/push/webhooks/GitLab polling | false (default)
DEMO_MODE=false
# hours between demo resets, only the banner text (the reset itself is a cron job); default 24
DEMO_RESET_HOURS=24

# --- ops scripts ---
# directory of ops/backup.sh archives; default ./backups
BACKUP_DIR=./backups

# --- development (compose.dev.yml, dev.sh) ---
# host port of the dev Postgres
DEV_PG_PORT=55433
# parallel dev stacks: COMPOSE_PROJECT_NAME, API_PORT (3000), WEB_PORT (5173); e2e takes E2E_BASE_URL
