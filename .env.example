# api (dev задаёт их сам в compose.dev.yml; здесь — для запуска вне compose и для prod)
DATABASE_URL=postgres://postgres:postgres@localhost:55433/planar
PORT=3000
# origin для проверки Origin и cookie, напр. http://localhost:5173
PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false
DATA_DIR=./data
MAX_UPLOAD_MB=50
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
LOG_LEVEL=info

# compose
DEV_PG_PORT=55433
# prod compose
POSTGRES_PASSWORD=postgres
SITE_ADDRESS=:80
