      "timeout": 600
    },
    {
      "name": "image",
      "cmd": "docker build -q -f apps/api/Dockerfile -t planar-api:cr8a . >/dev/null && docker run --rm --entrypoint sh planar-api:cr8a -c 'ls -d /app/modules/hello 2>/dev/null || find / -path /proc -prune -o -type d -name hello -path \"*modules*\" -print 2>/dev/null | head -1' && echo image-ok",
      "expect": "re:^image-ok$",
      "timeout": 1200
    },
    {
      "name": "test",
      "cmd": "pnpm test",
