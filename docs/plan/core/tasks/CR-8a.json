    },
    {
      "name": "build",
      "cmd": "pnpm -r build",
      "expect": "exit=0",
      "timeout": 600
    },
    {
      "name": "testdb",
      "cmd": "./dev.sh testdb",
      "expect": "exit=0",
      "timeout": 300
    },
    {
      "name": "modules_tests",
      "cmd": "pnpm exec vitest run apps/api/test/modules",
