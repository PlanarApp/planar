{
  "id": "WB-0",
  "module": "web",
  "type": "dp-mechanic",
  "title": "Зависимости и тестовая обвязка apps/web",
  "goal": "В apps/web установлены все зависимости фронтенда из roadmap §2 (для волн 1–3) и настроен Vitest (happy-dom + Vue), чтобы WB-1 и WB-2 шли параллельно, не трогая package.json и lock-файл.",
  "plan_ref": "§4 Правила среды",
  "contracts": [
    {
      "name": "C-ui",
      "version": "1",
      "ref": "docs/contracts/web.md"
    }
  ],
  "copy": "~/planar-web-WB-0",
  "branch": "web/WB-0",
  "base": "feature/web",
  "scope": [
    "apps/web/package.json",
    "pnpm-lock.yaml",
    "apps/web/vitest.config.ts"
  ],
  "dont_touch": [
    "apps/web/src/ — код пишут WB-1/WB-2",
    "vitest.config.ts (корень) и packages/ — владелец core",
    "apps/web/vite.config.ts — правит WB-1",
    "docs/",
    ".claude/",
    "CLAUDE.md"
  ],
  "accept": [
    {
      "name": "install",
      "cmd": "pnpm install --frozen-lockfile",
      "expect": "exit=0"
    },
    {
      "name": "shared-ws",
      "cmd": "node -e \"process.exit(require('./apps/web/package.json').dependencies['@planar/shared']==='workspace:*'?0:1)\"",
      "expect": "exit=0"
    },
    {
      "name": "build",
      "cmd": "pnpm --filter web build",
      "expect": "exit=0"
    },
    {
      "name": "vitest-config",
      "cmd": "cat apps/web/vitest.config.ts",
      "expect": "re:happy-dom"
    },
    {
      "name": "vitest-runs",
      "cmd": "pnpm --filter web exec vitest run --passWithNoTests no_such_test_file_xyz",
      "expect": "exit=0"
    },
    {
      "name": "test-script",
      "cmd": "node -e \"process.exit(require('./apps/web/package.json').scripts.test==='vitest run'?0:1)\"",
      "expect": "exit=0"
    },
    {
      "name": "deps",
      "cmd": "node -e \"const p=require('./apps/web/package.json');const a={...p.dependencies,...p.devDependencies};const m=['@planar/shared','vue-router','reka-ui','lucide-vue-next','vue-i18n','dexie','@tanstack/vue-virtual','vue-draggable-plus','@tiptap/vue-3','@tiptap/pm','@tiptap/starter-kit','@tiptap/extension-mention','@tiptap/extension-image','@tiptap/extension-placeholder','@tiptap/suggestion','uuidv7','fractional-indexing','workbox-window','tailwindcss','@tailwindcss/vite','vite-plugin-pwa','vitest','@vue/test-utils','happy-dom'].filter(n=>!a[n]);console.log('missing:'+m.join(','));process.exit(m.length)\"",
      "expect": "exit=0"
    }
  ],
